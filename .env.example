# st0x-issuance environment template
#
# Copy for local dev: cp .env.example .env
# Production deploy populates this via deploy.yaml envsubst (see
# .github/workflows/deploy.yaml).
#
# Signing: configure exactly one backend -- local EVM key (dev) or Fireblocks
# (production).

# --- Database ---

DATABASE_URL=sqlite:data.db
# DATABASE_MAX_CONNECTIONS=5

# --- Chain registry ---
#
# Today (Base-only): the legacy vars below map to a single `base` ChainRegistry
# entry (`RPC_URL`, `CHAIN_ID`, `SUBGRAPH_URL`, `BACKFILL_START_BLOCK`). Behaviour
# is identical to pre-multichain production.
#
# Multichain (when a second Network variant lands in RAI-1094): configure one
# block per chain. Canonical shape (this file is the authoritative record):
#
#   [[chains]]
#   network = "base"
#   chain_id = 8453
#   rpc_url = "wss://..."
#   subgraph_url = "https://..."
#   backfill_start_block = 41704326
#
#   [[chains]]
#   network = "ethereum"          # wire string must match Alpaca ITN + Network enum
#   chain_id = 1
#   rpc_url = "wss://..."
#   subgraph_url = "https://..."
#   backfill_start_block = 0
#
# Equivalent env-var encoding (planned -- not parsed until multichain config lands):
#
# CHAIN_BASE_RPC_URL=wss://...
# CHAIN_BASE_CHAIN_ID=8453
# CHAIN_BASE_SUBGRAPH_URL=https://...
# CHAIN_BASE_BACKFILL_START_BLOCK=41704326
#
# CHAIN_ETHEREUM_RPC_URL=wss://...
# CHAIN_ETHEREUM_CHAIN_ID=1
# CHAIN_ETHEREUM_SUBGRAPH_URL=https://...
# CHAIN_ETHEREUM_BACKFILL_START_BLOCK=0
#
# Fireblocks maps chain_id -> asset id for every configured chain (see below).
# Startup fails if a live tokenized asset's network has no registry entry.

# Legacy Base chain (single-chain / Base-only deployments)
RPC_URL=${RPC_URL}
CHAIN_ID=8453
SUBGRAPH_URL=${SUBGRAPH_URL}
BACKFILL_START_BLOCK=41704326

# --- Signer (choose one) ---

# Local dev / Anvil
# EVM_PRIVATE_KEY=0x...

# Fireblocks (production)
FIREBLOCKS_API_USER_ID=${FIREBLOCKS_API_USER_ID}
# FIREBLOCKS_SECRET_PATH=/data/fireblocks_secret.issuance.key
# FIREBLOCKS_VAULT_ACCOUNT_ID=0
# chain_id:asset_id pairs -- add an entry for every configured chain
FIREBLOCKS_CHAIN_ASSET_IDS=8453:BASECHAIN_ETH
# FIREBLOCKS_ENVIRONMENT=production

# --- Authentication ---

# Alpaca -> issuance (min 32 chars); used on ITN endpoints Alpaca calls
ISSUER_API_KEY=${ISSUER_API_KEY}
# Comma-separated CIDRs; empty disables IP filtering (not for production)
ALPACA_IP_RANGES=${ALPACA_IP_RANGES}
INTERNAL_IP_RANGES=127.0.0.0/8,::1/128,172.16.0.0/12,${INTERNAL_IP_RANGES_EXTRA}

# --- Alpaca broker API (issuance -> Alpaca) ---

ALPACA_API_BASE_URL=${ALPACA_API_BASE_URL}
ALPACA_ACCOUNT_ID=${ALPACA_ACCOUNT_ID}
ALPACA_API_KEY=${ALPACA_API_KEY}
ALPACA_API_SECRET=${ALPACA_API_SECRET}
# ALPACA_CONNECT_TIMEOUT_SECS=10
# ALPACA_REQUEST_TIMEOUT_SECS=30

# --- Observability ---

HYPERDX_API_KEY=${HYPERDX_API_KEY}
HYPERDX_SERVICE_NAME=${HYPERDX_SERVICE_NAME}
LOG_LEVEL=${LOG_LEVEL}

# --- Runtime ---

# Gates dev-only surfaces (OpenAPI docs / Swagger UI). Pinned to `production`
# so the deployed image never exposes them; unset also defaults to production.
ENVIRONMENT=production
